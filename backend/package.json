{
  "name": "roombites-backend",
  "version": "1.0.0",
  "description": "RoomBites campus food delivery backend API",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed/seedAll.js",
    "seed:admin": "node seed/seedAdmin.js",
    "seed:categories": "node seed/seedCategories.js",
    "seed:foods": "node seed/seedFoodItems.js",
